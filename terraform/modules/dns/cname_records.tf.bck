  domain = "KR-PRV-SW-2.${var.zone}"
  type   = "CNAME"
  cname  = technitium_record.sw2.domain
  ttl    = var.ttl
}
resource "technitium_record" "sw2_cname_2" {
  domain = "cbs220.${var.zone}"
  type   = "CNAME"
  cname  = technitium_record.sw2.domain
  ttl    = var.ttl
}
resource "technitium_record" "sw3_cname_1" {
  domain = "KR-PRV-SW-3.${var.zone}"
  type   = "CNAME"
  cname  = technitium_record.sw3.domain
  ttl    = var.ttl
