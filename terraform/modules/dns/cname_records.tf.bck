# Network Infrastructure
resource "technitium_record" "sw1_cname_1" {
  domain = "KR-PRV-SW-1.${var.zone}"
  type   = "CNAME"
  cname  = technitium_record.sw1.domain
  ttl    = var.ttl
}
resource "technitium_record" "sw1_cname_2" {
  domain = "cbs350.${var.zone}"
  type   = "CNAME"
  cname  = technitium_record.sw1.domain
  ttl    = var.ttl
}
